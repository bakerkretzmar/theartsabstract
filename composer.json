{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "bakerkretzmar/theartsabstract",
    "type": "project",
    "license": "proprietary",
    "homepage": "https://theartsabstract.ca",
    "repositories": [
        {
            "name": "wp-packages",
            "type": "composer",
            "url": "https://repo.wp-packages.org"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "require": {
        "php": "^8.5",
        "composer/installers": "^2.0",
        "cweagans/composer-patches": "^2.0",
        "oscarotero/env": "^2.0",
        "roots/acorn": "^6.0",
        "roots/acorn-prettify": "^1.0",
        "roots/bedrock-autoloader": "^1.0",
        "roots/bedrock-disallow-indexing": "^2.0",
        "roots/wordpress": "^6.9.9",
        "roots/wp-config": "^1.0",
        "vlucas/phpdotenv": "^5.0",
        "wp-cli/wp-cli-bundle": "^2.11",
        "wp-plugin/advanced-custom-fields": "^6.8.10",
        "wp-plugin/co-authors-plus": "^3.7",
        "wp-plugin/intervention": "^2.0"
    },
    "require-dev": {
        "laravel/pint": "^1.32"
    },
    "scripts": {
        "post-autoload-dump": [
            "Roots\\Acorn\\ComposerScripts::postAutoloadDump"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "allow-plugins": {
            "composer/installers": true,
            "roots/wordpress-core-installer": true,
            "cweagans/composer-patches": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "acorn": {
            "providers": [
                "App\\Providers\\AssetsServiceProvider",
                "App\\Providers\\ThemeServiceProvider"
            ]
        },
        "installer-paths": {
            "public/content/mu-plugins/{$name}/": [
                "type:wordpress-muplugin",
                "wp-plugin/advanced-custom-fields",
                "wp-plugin/co-authors-plus",
                "wp-plugin/intervention"
            ],
            "public/content/plugins/{$name}/": [
                "type:wordpress-plugin"
            ],
            "public/content/themes/{$name}/": [
                "type:wordpress-theme"
            ]
        },
        "wordpress-install-dir": "public/wp",
        "patches": {
            "wp-plugin/intervention": {
                "Declare properties and explicit nullable callbacks for PHP 8.5": "patches/intervention-php85.patch"
            },
            "wp-plugin/co-authors-plus": {
                "Resolve block editor assets relative to the MU plugin": "patches/co-authors-plus-mu-plugin-assets.patch"
            }
        }
    }
}
