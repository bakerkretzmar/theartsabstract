{
    "name": "bakerkretzmar/theartsabstract",
    "type": "project",
    "repositories": [
        {
            "type": "composer",
            "url": "https://wpackagist.org",
            "only": ["wpackagist-plugin/*", "wpackagist-theme/*"]
        }
    ],
    "require": {
        "php": "^8.5",
        "composer/installers": "^2.3",
        "laravel/envoy": "^2.12.2",
        "oscarotero/env": "^2.1.1",
        "roots/acorn": "^2.1.3",
        "roots/bedrock-autoloader": "^1.1",
        "roots/bedrock-disallow-indexing": "^2.1",
        "roots/soil": "^4.1.1",
        "roots/wordpress": "^6.9.9",
        "roots/wp-config": "1.0.0",
        "roots/wp-password-bcrypt": "1.1.0",
        "soberwp/intervention": "dev-main",
        "vlucas/phpdotenv": "^5.7",
        "wp-cli/wp-cli-bundle": "^2.11",
        "wpackagist-plugin/advanced-custom-fields": "^6.8.10",
        "wpackagist-plugin/co-authors-plus": "^3.7"
    },
    "extra": {
        "installer-paths": {
            "web/app/mu-plugins/{$name}/": [
                "type:wordpress-muplugin",
                "roots/soil",
                "soberwp/intervention",
                "wpackagist-plugin/advanced-custom-fields",
                "wpackagist-plugin/co-authors-plus"
            ],
            "web/app/plugins/{$name}/": ["type:wordpress-plugin"],
            "web/app/themes/{$name}/": ["type:wordpress-theme"]
        },
        "wordpress-install-dir": "web/wp"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "roots/wordpress-core-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
